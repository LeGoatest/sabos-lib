{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sabos:seobasic:agents:manifest:0.1.0",
  "title": "SEObasic Machine Interface Manifest",
  "type": "object",
  "required": ["spec_version", "kind", "id", "system", "authority", "load_order", "collections", "schemas", "validation"],
  "properties": {
    "spec_version": {"type": "string"},
    "kind": {"const": "sabos.machine-interface"},
    "id": {"const": "seobasic.agents"},
    "system": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "seobasic"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["mode", "canonical_entrypoint", "conflict_resolution"],
      "properties": {
        "mode": {"const": "projection"},
        "canonical_entrypoint": {"type": "string"},
        "conflict_resolution": {"const": "canonical_sources_win"}
      },
      "additionalProperties": true
    },
    "load_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "collections": {"type": "object"},
    "schemas": {"type": "object"},
    "validation": {"type": "object"}
  },
  "additionalProperties": true
}
